CREATE TABLE PACIENTE (
    cpf VARCHAR(14) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    data_nascimento DATE NOT NULL,
    telefone VARCHAR(15),
    endereco VARCHAR(255),
    usuario VARCHAR(50) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL
);
CREATE TABLE MEDICO (
    crm VARCHAR(20) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    especialidade VARCHAR(100) NOT NULL,
    telefone VARCHAR(15),
    usuario VARCHAR(50) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,
    preco_consulta DECIMAL(10,2) NOT NULL
);
CREATE TABLE CONSULTA (
    id_consulta INT IDENTITY(1,1) PRIMARY KEY,
    cpf_paciente VARCHAR(14) NOT NULL,
    crm_medico VARCHAR(20) NOT NULL,
    data_consulta DATETIME NOT NULL,
    diagnostico TEXT,
    observacoes TEXT,
    preco DECIMAL(10,2) NOT NULL,
    imposto AS (CONVERT(DECIMAL(10,2), preco * 0.15)) PERSISTED, -- imposto de 15%
    total AS (CONVERT(DECIMAL(10,2), preco * 1.15)) PERSISTED,
    FOREIGN KEY (cpf_paciente) REFERENCES PACIENTE(cpf),
    FOREIGN KEY (crm_medico) REFERENCES MEDICO(crm)
);

-- Diagnóstico referenciado na consulta
CREATE TABLE DIAGNOSTICO (
    id_diagnostico INT IDENTITY(1,1) PRIMARY KEY,
    id_consulta INT NOT NULL,
    descricao TEXT NOT NULL,
    data_registro DATETIME NOT NULL,
    FOREIGN KEY (id_consulta) REFERENCES CONSULTA(id_consulta)
);

-- Receita referenciada na consulta
CREATE TABLE RECEITA (
    id_receita INT IDENTITY(1,1) PRIMARY KEY,
    id_consulta INT NOT NULL,
    medicamento VARCHAR(100) NOT NULL,
    dosagem VARCHAR(50),
    instrucoes TEXT,
    descricao TEXT NOT NULL,
    data_emissao DATETIME NOT NULL,
    FOREIGN KEY (id_consulta) REFERENCES CONSULTA(id_consulta)
);

GRANT SELECT ON CONSULTA TO paciente_user;
GRANT SELECT ON RECEITA TO paciente_user;
GRANT SELECT ON DIAGNOSTICO TO paciente_user;

GRANT INSERT, UPDATE ON PACIENTE TO medico_user;
